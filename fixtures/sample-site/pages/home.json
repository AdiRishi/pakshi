{
  "schema": "pakshi.page/1",
  "id": "pg_home",
  "type": "page",
  "path": "/",
  "meta": {
    "title": "Harbour Summer School",
    "description": "Five days of hands-on workshops at the harbour."
  },
  "root": ["b_hero", "b_numbers", "b_week", "b_about", "b_voices", "b_questions", "b_register"],
  "blocks": {
    "b_hero": {
      "type": "hero",
      "variant": "split",
      "surface": "default",
      "props": {
        "kicker": "Summer school 2027",
        "heading": "Learn by building",
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Mornings are for making. Afternoons are for trying what you made on the water."
                }
              ]
            }
          ]
        },
        "actions": [
          {
            "id": "it_register",
            "button": {
              "label": "Register",
              "link": "https://example.org/register"
            }
          },
          {
            "id": "it_programme",
            "button": {
              "label": "See the programme",
              "link": {
                "$ref": "page",
                "id": "pg_programme"
              }
            }
          }
        ],
        "points": [
          {
            "id": "it_beginners",
            "point": "No experience needed"
          },
          {
            "id": "it_tools",
            "point": "Tools provided"
          },
          {
            "id": "it_lunch",
            "point": "Lunch every day"
          }
        ],
        "image": {
          "$ref": "media",
          "id": "med_harbour",
          "alt": "Two sailing boats on a calm harbour at sunset"
        },
        "frame": "framed",
        "backdrop": "glow"
      }
    },
    "b_numbers": {
      "type": "stats",
      "variant": "row",
      "surface": "muted",
      "props": {
        "stats": [
          {
            "id": "it_days",
            "value": "5",
            "label": "days at the harbour"
          },
          {
            "id": "it_boats",
            "value": "14",
            "label": "boats launched last summer"
          },
          {
            "id": "it_mentors",
            "value": "1:6",
            "label": "mentors to students"
          },
          {
            "id": "it_places",
            "value": "60",
            "label": "places each summer"
          }
        ],
        "align": "center"
      }
    },
    "b_week": {
      "type": "feature-grid",
      "variant": "grid",
      "surface": "default",
      "props": {
        "kicker": "The week",
        "heading": "What's included",
        "intro": "Everything you need is at the boatshed. Bring clothes that can get wet.",
        "actions": [],
        "style": "cards"
      },
      "slots": {
        "items": ["b_workshops", "b_mentors", "b_launch"]
      }
    },
    "b_workshops": {
      "type": "feature-item",
      "variant": "default",
      "props": {
        "icon": "hammer",
        "title": "Workshops",
        "body": "Two sessions a day on the workshop floor, from shaping a hull to fitting a mast."
      }
    },
    "b_mentors": {
      "type": "feature-item",
      "variant": "default",
      "props": {
        "icon": "users",
        "title": "Mentors",
        "body": "One mentor for every six students, each a boatbuilder or sailmaker who has built the thing before."
      }
    },
    "b_launch": {
      "type": "feature-item",
      "variant": "default",
      "props": {
        "icon": "sailboat",
        "title": "Launch day",
        "body": "On Friday afternoon every boat built during the week goes into the water."
      }
    },
    "b_about": {
      "type": "rich-text",
      "variant": "sidebar",
      "surface": "default",
      "props": {
        "heading": "What you'll do",
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Each day starts with a short talk, then moves to the workshop floor. You'll work in "
                },
                {
                  "type": "text",
                  "text": "small teams",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " with a mentor who has built the thing before."
                }
              ]
            },
            {
              "type": "heading",
              "attrs": {
                "level": 3
              },
              "content": [
                {
                  "type": "text",
                  "text": "Bring with you"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Clothes that can get wet"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A water bottle and a sun hat"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Questions? Read the "
                },
                {
                  "type": "text",
                  "text": "frequently asked questions",
                  "marks": [
                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://example.org/faq"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            }
          ]
        }
      }
    },
    "b_voices": {
      "type": "testimonials",
      "variant": "grid",
      "surface": "tint",
      "props": {
        "kicker": "Last summer",
        "heading": "In their words",
        "actions": []
      },
      "slots": {
        "items": ["b_priya", "b_tom", "b_asha"]
      }
    },
    "b_priya": {
      "type": "testimonial",
      "variant": "default",
      "props": {
        "quote": "I'd never held a chisel before. By Friday I'd built a boat that floats, and I rowed it across the harbour myself.",
        "name": "Priya Shah",
        "role": "Student, summer 2026"
      }
    },
    "b_tom": {
      "type": "testimonial",
      "variant": "default",
      "props": {
        "quote": "The mentors treat every student like an apprentice. My son came home talking about scarf joints.",
        "name": "Tom Reyes",
        "role": "Parent"
      }
    },
    "b_asha": {
      "type": "testimonial",
      "variant": "default",
      "props": {
        "quote": "Small groups, real tools and a tide that doesn't wait. It's the best week of my year.",
        "name": "Asha Patel",
        "role": "Mentor since 2019"
      }
    },
    "b_questions": {
      "type": "faq",
      "variant": "split",
      "surface": "default",
      "props": {
        "heading": "Questions",
        "questions": [
          {
            "id": "it_age",
            "question": "Who is summer school for?",
            "answer": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Anyone aged 12 and over. Students under 16 come with a parent's consent form."
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "it_swim",
            "question": "Do I need to be able to swim?",
            "answer": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Yes, 50 metres. Everyone wears a buoyancy aid on the water, and a safety boat is always close by."
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "it_bring",
            "question": "What should I bring?",
            "answer": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Clothes that can get wet, sturdy shoes and a water bottle. "
                    },
                    {
                      "type": "text",
                      "text": "We provide tools, safety gear and lunch.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "it_keep",
            "question": "Can I take my boat home?",
            "answer": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Most students do. Boats stay at the boatshed for a week after launch day, so you can arrange to collect it."
                    }
                  ]
                }
              ]
            }
          }
        ],
        "contact": "Anything else? We reply within a day.",
        "actions": [
          {
            "id": "it_ask",
            "button": {
              "label": "Ask a question",
              "link": "mailto:hello@example.org"
            }
          }
        ],
        "align": "start"
      }
    },
    "b_register": {
      "type": "call-to-action",
      "variant": "centered",
      "surface": "brand",
      "props": {
        "heading": "Places are limited",
        "intro": "Registration closes on 30 November.",
        "actions": [
          {
            "id": "it_register",
            "button": {
              "label": "Register now",
              "link": "https://example.org/register"
            }
          },
          {
            "id": "it_ask",
            "button": {
              "label": "Ask a question",
              "link": "mailto:hello@example.org"
            }
          }
        ],
        "backdrop": "arc"
      }
    }
  }
}
