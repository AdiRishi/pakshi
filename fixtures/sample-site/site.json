{
  "brand": {
    "id": "brand_harbour",
    "name": "Harbour Schools",
    "theme": {
      "brandColor": "#125ca1",
      "neutral": "warm",
      "fonts": {
        "heading": "literata",
        "body": "work-sans"
      },
      "typeScale": "medium",
      "headingWeight": 600,
      "radius": "small",
      "shadow": "soft",
      "density": "comfortable",
      "imageCorners": "rounded",
      "motion": true
    },
    "identity": {
      "logo": "med_harbourlogo",
      "logoOnDark": "med_harbourlogolight",
      "favicon": "med_harbouricon"
    }
  },
  "site": {
    "id": "site_harbour",
    "name": "Harbour Summer School"
  },
  "snapshot": "snap_sample1",
  "release": "rel_sample1",
  "lockfile": {
    "call-to-action": 1,
    "feature-grid": 1,
    "feature-item": 1,
    "footer": 1,
    "form-section": 1,
    "gallery": 1,
    "header": 1,
    "hero": 1,
    "post-list": 2,
    "rich-text": 1,
    "split": 1
  },
  "parts": {
    "header": "b_siteheader",
    "footer": "b_sitefooter",
    "blocks": {
      "b_siteheader": {
        "type": "header",
        "variant": "simple",
        "surface": "default",
        "props": {
          "cta": {
            "label": "Register",
            "link": "https://example.org/register"
          }
        }
      },
      "b_sitefooter": {
        "type": "footer",
        "variant": "simple",
        "surface": "muted",
        "props": {
          "note": "Harbour Schools runs summer school with the Harbour Sailing Trust."
        }
      }
    },
    "menus": {
      "main": [
        {
          "id": "mi_home",
          "label": "Home",
          "target": {
            "$ref": "page",
            "id": "pg_home"
          }
        },
        {
          "id": "mi_programme",
          "label": "Programme",
          "target": {
            "$ref": "page",
            "id": "pg_programme"
          }
        }
      ],
      "footer": [
        {
          "id": "mi_contact",
          "label": "Contact",
          "target": "mailto:hello@example.org"
        }
      ]
    }
  },
  "forms": {},
  "media": {
    "med_harbour": {
      "contentType": "image/jpeg",
      "width": 1600,
      "height": 1067,
      "alt": "Two sailing boats on a calm harbour at sunset"
    },
    "med_harbourlogo": {
      "contentType": "image/png",
      "width": 678,
      "height": 136,
      "alt": "Harbour Schools"
    },
    "med_harbourlogolight": {
      "contentType": "image/png",
      "width": 678,
      "height": 136,
      "alt": "Harbour Schools, for dark backgrounds"
    },
    "med_harbouricon": {
      "contentType": "image/png",
      "width": 512,
      "height": 512,
      "alt": "Harbour Schools icon"
    }
  },
  "gone": ["/old-programme"]
}
