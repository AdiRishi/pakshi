{
  "brand": {
    "id": "brand_harbour",
    "name": "Harbour Schools",
    "theme": {
      "brandColor": "#125ca1",
      "neutral": "warm",
      "fonts": {
        "heading": "literata",
        "body": "work-sans"
      },
      "typeScale": "medium",
      "headingWeight": 600,
      "radius": "small",
      "shadow": "soft",
      "density": "comfortable",
      "imageCorners": "rounded",
      "motion": true
    },
    "identity": {
      "logo": "med_harbourlogo",
      "logoOnDark": "med_harbourlogolight",
      "favicon": "med_harbouricon"
    }
  },
  "site": {
    "id": "site_harbour",
    "name": "Harbour Summer School"
  },
  "snapshot": "snap_sample1",
  "release": "rel_sample1",
  "lockfile": {
    "bento": 1,
    "bento-tile": 1,
    "call-to-action": 2,
    "card": 1,
    "cards": 1,
    "contact-details": 2,
    "event-card": 2,
    "event-cards": 2,
    "faq": 2,
    "feature-grid": 2,
    "feature-item": 2,
    "footer": 2,
    "form-section": 2,
    "gallery": 2,
    "header": 3,
    "hero": 4,
    "image-caption": 2,
    "location": 2,
    "logo-strip": 2,
    "post-header": 2,
    "post-list": 3,
    "pricing": 1,
    "pricing-plan": 1,
    "quote": 2,
    "rich-text": 2,
    "split": 2,
    "statement": 1,
    "stats": 2,
    "steps": 1,
    "team-grid": 2,
    "team-member": 2,
    "testimonial": 1,
    "testimonials": 1,
    "timeline": 2
  },
  "parts": {
    "header": "b_siteheader",
    "footer": "b_sitefooter",
    "blocks": {
      "b_siteheader": {
        "type": "header",
        "variant": "standard",
        "surface": "default",
        "props": {
          "cta": {
            "label": "Register",
            "link": "https://example.org/register"
          },
          "announcement": "Registration for summer 2027 closes on 30 November",
          "announcementLink": "https://example.org/register",
          "position": "sticky"
        }
      },
      "b_sitefooter": {
        "type": "footer",
        "variant": "columns",
        "surface": "inverse",
        "props": {
          "note": "Harbour Schools runs summer school with the Harbour Sailing Trust.",
          "social": [
            {
              "id": "it_instagram",
              "icon": "instagram",
              "link": "https://instagram.com/example"
            },
            {
              "id": "it_youtube",
              "icon": "youtube",
              "link": "https://youtube.com/example"
            }
          ],
          "legal": "© 2027 Harbour Schools"
        }
      }
    },
    "menus": {
      "main": [
        {
          "id": "mi_home",
          "label": "Home",
          "target": {
            "$ref": "page",
            "id": "pg_home"
          }
        },
        {
          "id": "mi_programme",
          "label": "Programme",
          "target": {
            "$ref": "page",
            "id": "pg_programme"
          }
        }
      ],
      "footer": [
        {
          "id": "mi_contact",
          "label": "Contact",
          "target": "mailto:hello@example.org"
        }
      ]
    }
  },
  "forms": {},
