---
import "@repo/blocks/site.css";
import { renderPage, siteData, SitePage } from "@repo/blocks";
import { themeCss } from "@repo/tokens";

import { loadManifest, loadPage } from "../lib/snapshot.ts";

const { site } = Astro.locals;
const manifest = await loadManifest(site.id, site.live.snapshot);
const path = `/${Astro.params.path ?? ""}`;
const entry = manifest.pages.find((candidate) => candidate.path === path);
if (entry === undefined) {
  Astro.response.status = manifest.gone.includes(path) ? 410 : 404;
}
const page = entry === undefined ? null : await loadPage(site.id, entry.object);
const rendered = page === null ? null : await renderPage(page, manifest.parts, manifest.lockfile);
const data = siteData({
  settings: manifest.settings,
  identity: manifest.brand.identity,
  menus: manifest.parts.menus,
  pages: manifest.pages,
  forms: manifest.forms,
  media: (id) => {
    const file = manifest.media[id];
    return file === undefined ? undefined : { src: `/_media/${id}`, width: file.width, height: file.height };
  },
});
const { favicon } = manifest.brand.identity;
// A new site's first release has no pages until its first draft publishes.
const unpublished = manifest.pages.length === 0;
const title =
  page?.meta.title ??
  (unpublished ? manifest.settings.name : Astro.response.status === 410 ? "Page removed" : "Page not found");
const message = unpublished
  ? "This site hasn't been published yet."
  : Astro.response.status === 410
    ? "This page has been taken down."
    : "There's no page at this address.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === manifest.settings.name ? title : `${title} · ${manifest.settings.name}`}</title>
    {page && <meta name="description" content={page.meta.description} />}
    {favicon && <link rel="icon" href={`/_media/${favicon}`} />}
    <style is:inline set:html={themeCss(manifest.brand.theme)}></style>
  </head>
  <body>
    {
      rendered ? (
        <SitePage site={data} header={rendered.header} sections={rendered.sections} footer={rendered.footer} />
      ) : (
        <main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center gap-4 px-6">
          <h1 class="text-title">{title}</h1>
          <p class="text-lead text-muted-foreground">{message}</p>
          {!unpublished && (
            <a class="text-primary underline" href="/">
              Go to the home page
            </a>
          )}
        </main>
      )
    }
  </body>
</html>
