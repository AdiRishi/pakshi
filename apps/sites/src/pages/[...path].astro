---
import "@repo/blocks/site.css";
import { renderPage, siteData, SitePage } from "@repo/blocks";
import { FormId } from "@repo/contracts/ids";
import { themeCss } from "@repo/tokens";
import { Option, Schema } from "effect";

import { pageNumberOf } from "../lib/page-cache.ts";
import { responsiveImage } from "../lib/responsive.ts";
import { styleHash } from "../lib/security.ts";
import { pageMeta, redirectFor } from "../lib/seo.ts";
import { loadManifest, loadPage } from "../lib/snapshot.ts";

const { site } = Astro.locals;
const manifest = await loadManifest(site.id, site.live.snapshot);
const path = `/${Astro.params.path ?? ""}`;
const entry = manifest.pages.find((candidate) => candidate.path === path);
const redirect = entry === undefined ? redirectFor(manifest, path) : null;
if (redirect !== null) return Astro.redirect(redirect, 301);
if (entry === undefined) {
  Astro.response.status = manifest.gone.includes(path) ? 410 : 404;
}
const page = entry === undefined ? null : await loadPage(site.id, entry.object);
const rendered = page === null ? null : await renderPage(page, manifest.parts, manifest.lockfile);
const sent = Schema.decodeUnknownOption(FormId)(Astro.url.searchParams.get("sent"));
const data = {
  ...siteData({
    settings: manifest.settings,
    identity: manifest.brand.identity,
    menus: manifest.parts.menus,
    pages: manifest.pages,
    forms: manifest.forms,
    media: (id) => {
      const file = manifest.media[id];
      return file === undefined ? undefined : responsiveImage(id, file);
    },
  }),
  sent: Option.getOrNull(sent),
  current: entry === undefined ? null : { page: entry.id, number: pageNumberOf(Astro.url) },
};
const { favicon } = manifest.brand.identity;
const theme = themeCss(manifest.brand.theme);
Astro.csp.insertStyleHash(await styleHash(theme));
const seo =
  page === null || entry === undefined ? null : pageMeta(page, entry, manifest, Astro.url.origin);
// A new site's first release has no pages until its first draft publishes.
const unpublished = manifest.pages.length === 0;
const title =
  page?.meta.title ??
  (unpublished ? manifest.settings.name : Astro.response.status === 410 ? "Page removed" : "Page not found");
const message = unpublished
  ? "This site hasn't been published yet."
  : Astro.response.status === 410
    ? "This page has been taken down."
    : "There's no page at this address.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === manifest.settings.name ? title : `${title} · ${manifest.settings.name}`}</title>
    {page && <meta name="description" content={page.meta.description} />}
    {
      page && seo && (
        <>
          <link rel="canonical" href={seo.canonical} />
          {seo.noindex && <meta name="robots" content="noindex" />}
          <meta property="og:type" content={seo.type} />
          <meta property="og:site_name" content={manifest.settings.name} />
          <meta property="og:title" content={page.meta.title} />
          <meta property="og:description" content={page.meta.description} />
          <meta property="og:url" content={seo.canonical} />
          {seo.image && (
            <>
              <meta property="og:image" content={seo.image.src} />
              <meta property="og:image:width" content={String(seo.image.width)} />
              <meta property="og:image:height" content={String(seo.image.height)} />
              <meta property="og:image:alt" content={seo.image.alt} />
            </>
          )}
          <meta name="twitter:card" content={seo.image ? "summary_large_image" : "summary"} />
        </>
      )
    }
    {favicon && <link rel="icon" href={`/_media/${favicon}`} />}
    <style is:inline set:html={theme}></style>
  </head>
  <body>
    {
      rendered ? (
        <SitePage site={data} header={rendered.header} sections={rendered.sections} footer={rendered.footer} />
      ) : (
        <main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center gap-4 px-6">
          <h1 class="text-title">{title}</h1>
          <p class="text-lead text-muted-foreground">{message}</p>
          {!unpublished && (
            <a class="text-primary underline" href="/">
              Go to the home page
            </a>
          )}
        </main>
      )
    }
  </body>
</html>
