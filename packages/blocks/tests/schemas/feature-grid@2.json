            "required": [
              "id",
              "button"
            ],
            "additionalProperties": true
          },
          "maxItems": 2
        },
        "columns": {
          "type": "string",
          "enum": [
            "3",
            "2",
            "4"
          ]
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center"
          ]
        },
        "style": {
          "type": "string",
          "enum": [
            "plain",
            "cards",
            "lines"
          ]
        },
        "background": {
          "type": "string",
          "enum": [
            "full",
            "inset"
          ]
        }
      },
      "required": [
        "heading",
        "actions"
      ],
      "additionalProperties": true
    },
