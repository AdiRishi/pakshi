                    {
                      "type": "link",
                      "attrs": {
                        "href": "https://example.org/book"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " and we'll put you in the same group."
                }
              ]
            }
          ]
        }
      }
    ],
    "contact": "Something else on your mind?",
    "actions": [
      {
        "id": "it_contact",
        "button": {
          "label": "Get in touch",
