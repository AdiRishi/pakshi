  "props": {
    "heading": "Good to know",
    "intro": "The questions we hear most from students.",
    "questions": [
      {
        "id": "it_age",
        "question": "How old do I need to be?",
        "answer": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Summer school is for ages 14 to 18. Juniors aged 10 to 13 can join our three-morning course."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "it_keep",
        "question": "Can I keep my boat?",
        "answer": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Yes. It's yours to take home, or you can give it to the harbour fleet for next year's students."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "it_weather",
        "question": "What if it rains?",
