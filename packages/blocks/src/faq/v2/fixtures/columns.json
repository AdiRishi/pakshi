          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Workshops carry on in the boatshed. We only go out on the water when the harbour master says it's safe."
                }
              ]
            }
          ]
        }
      },
      {
        "id": "it_friends",
        "question": "Can I come with a friend?",
        "answer": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Of course. Say so when you "
                },
                {
