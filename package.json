{
  "name": "pakshi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "dotenv -e .env.turbo.local -- turbo build",
    "check": "oxlint --disable-nested-config && oxfmt --check",
    "dev": "dotenv -e .env.turbo.local -- turbo dev --ui=stream --filter @repo/infra",
    "dev:destroy": "pnpm --filter @repo/infra dev:destroy",
    "docs:build": "blume build",
    "docs:dev": "blume dev",
    "docs:doctor": "blume doctor",
    "fix": "oxlint --disable-nested-config --fix && oxfmt",
    "plan": "pnpm --filter @repo/infra plan",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "prod": "dotenv -e .env.turbo.local -- turbo deploy --ui=stream --filter @repo/infra",
    "sync:repos": "node scripts/src/sync-reference-repos.ts",
    "test": "dotenv -e .env.turbo.local -- turbo test",
    "test:unit": "dotenv -e .env.turbo.local -- turbo test --filter=!@repo/infra",
    "typecheck": "dotenv -e .env.turbo.local -- turbo typecheck",
    "prod:destroy": "pnpm --filter @repo/infra prod:destroy"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "blume": "catalog:",
    "dotenv-cli": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@12.6.0"
}
